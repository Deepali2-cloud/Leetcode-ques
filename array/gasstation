class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
        int totalgas=0;
        int totalcost=0;
        int currentfuel=0;
        int start=0;

        for(int i=0;i<gas.length;i++){
            totalgas+=gas[i];
            totalcost+=cost[i];

        currentfuel+=gas[i]-cost[i];

        if(currentfuel<0){
            start=i+1;
            currentfuel=0;

        }
        }
        if(totalgas<totalcost){
            return -1;
        }
        return start;
    }
}
